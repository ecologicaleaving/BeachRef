# BeachRef Environment Configuration Template
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Client-side - safe to expose)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: Never commit .env files with real values to git!
# The .env.local file should contain your actual credentials

# Development/Production Environment
NODE_ENV=development

# API Configuration
EXPO_PUBLIC_VIS_API_BASE_URL=https://www.fivb.org/Vis2009/XmlRequest.asmx
EXPO_PUBLIC_API_TIMEOUT=30000

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG_LOGGING=false
EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Google Analytics 4 (optional)
EXPO_PUBLIC_GA_ID=G-GP7SB18S2C

# Sentry (optional - for production error tracking)
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn
