# BeachRef Environment Configuration Template
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Client-side - safe to expose)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# IMPORTANT: Never commit .env files with real values to git!
# The .env.local file should contain your actual credentials

# Development/Production Environment
NODE_ENV=development

# API Configuration
EXPO_PUBLIC_VIS_API_BASE_URL=https://www.fivb.org/Vis2009/XmlRequest.asmx
EXPO_PUBLIC_API_TIMEOUT=30000

# Feature Flags
EXPO_PUBLIC_ENABLE_DEBUG_LOGGING=false
EXPO_PUBLIC_ENABLE_PERFORMANCE_MONITORING=true
EXPO_PUBLIC_ENABLE_CRASH_REPORTING=true

# Google Analytics 4 (optional)
EXPO_PUBLIC_GA_ID=G-GP7SB18S2C

# Sentry (optional - for production error tracking)
# EXPO_PUBLIC_SENTRY_DSN=your-sentry-dsn

# ---------------------------------------------------------------------------
# Maintenance scripts (server-side only — NEVER prefix these with EXPO_PUBLIC_)
# ---------------------------------------------------------------------------
# Anything prefixed EXPO_PUBLIC_ is inlined into the client bundle and is
# therefore public. The variables below must stay out of the bundle: they are
# read only by scripts/ run from a shell, and every one of those scripts exits
# non-zero with an explicit message when a variable is missing. There are no
# hardcoded fallbacks — see issue #56.
#
# Consumed by: scripts/setup-supabase.js (npm run setup-supabase),
#              scripts/test-database-schema.js (npm run test-database),
#              scripts/apply-migration-005.js, scripts/insert-test-data.js,
#              scripts/populate-referee-data.js, scripts/trigger-data-sync.js,
#              scripts/check-schema-status.js
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# service_role key — full bypass of Row Level Security. Treat as a root password:
# shell environment or a secret manager only, never a file tracked by git.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres connection, only if you run psql/pg against the database.
# Keep the password in the environment, never inline in a script.
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# FIVB VIS API credentials (optional — only for the authenticated endpoints)
# FIVB_APP_ID=your-fivb-app-id
