# local env files
.env*.local
.env

# Secrets & one-off working files (issue #56)
# A prod superuser password sat in a tracked root script for ten months on a
# public repo. These patterns cover the shapes that let it happen: SQL fragments
# written to the repo root by migration runners, ad-hoc scripts people paste
# credentials into, and database dumps.
temp_migration_*.sql
*.dump
*.sql.gz
*.sqlite
*.sqlite3
secrets.json
credentials.json
service-account*.json
*-service-role*.json

# Supabase CLI local state (contains pooler connection strings)
supabase/.temp/
supabase/.branches/

# typescript
*.tsbuildinfo

# logs
*.log
logs/

# builds
build/

app-example
expo-go.apk

# Project documentation and architecture
docs/
archive/
architecture/

# Audit history (contains historical finding data)
.audit-history/

# Local Netlify folder
.netlify
.commit-automation/cache/

# BeachRef-app è una repo Flutter separata
BeachRef-app/
