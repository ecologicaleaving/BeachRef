#!/bin/sh
# husky v9 sources this file itself; the legacy `. "$(dirname "$0")/_/husky.sh"`
# line is deprecated and made the hook impossible to run standalone.

echo "🔍 Pre-commit audit: TypeScript + ESLint + Complexity + Security"
echo "   (fast subset — the full 9-checker audit runs on push and in CI)"
echo ""

# Fast quality subset + the security scanner. Security is here because of issue
# #56: a production superuser password sat in a tracked file for ten months, and
# the scanner that would have caught it only ran on push. It costs ~4s on the
# whole tree (issue #60 removed the 500-file cap that was silently hiding 36%
# of it, including every Deno Edge Function).
# The audit itself prints which checkers are NOT running.
npm run audit:precommit -- --fail-on=critical
AUDIT_EXIT_CODE=$?

if [ $AUDIT_EXIT_CODE -eq 2 ]; then
  echo ""
  echo "🔴 Commit blocked: the audit could not run one or more checkers."
  echo ""
  echo "   This is a broken audit setup, not a code problem — the output above"
  echo "   is NOT a clean bill of health. Fix the checker error and retry."
  echo ""
  exit 1
fi

if [ $AUDIT_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked: new Critical findings vs .audit-baseline.json"
  echo ""
  echo "   If the finding is 'security-credential', STOP. Do not baseline it and"
  echo "   do not --no-verify past it. Move the value to an environment variable"
  echo "   and document it in .env.example. A secret in a tracked file on a"
  echo "   public repo is compromised the moment it is pushed."
  echo ""
  echo "   Otherwise:"
  echo "   1. Fix the findings listed above, or"
  echo "   2. Run 'npm run audit -- --checks=precommit' to see them again"
  echo ""
  echo "   If a finding is legitimately expected, regenerate the baseline with"
  echo "   'npm run audit:baseline' and commit the diff so it stays reviewable."
  echo ""
  exit 1
fi

echo ""
echo "✅ Pre-commit subset passed: no new Critical findings in"
echo "   TypeScript/ESLint/Complexity/Security."
echo "   NOT checked here: architecture, error-handling, performance,"
echo "   data-flow, build — those run on 'git push' and in CI."
echo ""
