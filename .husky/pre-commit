#!/bin/sh
# husky v9 sources this file itself; the legacy `. "$(dirname "$0")/_/husky.sh"`
# line is deprecated and made the hook impossible to run standalone.

echo "🔍 Pre-commit audit: TypeScript + ESLint + Complexity"
echo "   (fast subset — the full 9-checker audit runs on push and in CI)"
echo ""

# Fast quality subset. The audit itself prints which checkers are NOT running.
npm run audit:quality -- --fail-on=critical
AUDIT_EXIT_CODE=$?

if [ $AUDIT_EXIT_CODE -eq 2 ]; then
  echo ""
  echo "🔴 Commit blocked: the audit could not run one or more checkers."
  echo ""
  echo "   This is a broken audit setup, not a code problem — the output above"
  echo "   is NOT a clean bill of health. Fix the checker error and retry."
  echo ""
  exit 1
fi

if [ $AUDIT_EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ Commit blocked: new Critical findings vs .audit-baseline.json"
  echo ""
  echo "   1. Fix the findings listed above, or"
  echo "   2. Run 'npm run audit -- --checks=quality' to see them again"
  echo ""
  echo "   If a finding is legitimately expected, regenerate the baseline with"
  echo "   'npm run audit:baseline' and commit the diff so it stays reviewable."
  echo ""
  exit 1
fi

echo ""
echo "✅ Pre-commit subset passed: no new Critical findings in TypeScript/ESLint/Complexity."
echo "   NOT checked here: security, architecture, error-handling, performance,"
echo "   data-flow, build — those run on 'git push' and in CI."
echo ""
