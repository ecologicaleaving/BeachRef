{
  "name": "startapp",
  "main": "expo-router/entry",
  "version": "1.0.3",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test": "jest",
    "test:integration": "jest --config=__tests__/integration/setup/jest.integration.config.js",
    "test:integration:watch": "jest --config=__tests__/integration/setup/jest.integration.config.js --watch",
    "test:integration:coverage": "jest --config=__tests__/integration/setup/jest.integration.config.js --coverage",
    "test:contrast": "jest --testPathPattern=\"contrastValidator.test\"",
    "validate:contrast": "node scripts/validate-contrast.js",
    "validate:accessibility": "npm run validate:contrast && npm run test:contrast",
    "setup-supabase": "node scripts/setup-supabase.js",
    "test-database": "node scripts/test-database-schema.js",
    "audit": "tsx scripts/audit/run-audit.ts",
    "audit:ci": "tsx scripts/audit/run-audit.ts --ci --fail-on=critical,high",
    "audit:watch": "tsx scripts/audit/run-audit.ts --watch",
    "fix-undefined": "tsx scripts/fix-possibly-undefined.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@sentry/react-native": "^7.4.0",
    "@supabase/supabase-js": "^2.54.0",
    "@tanstack/react-query": "^5.87.1",
