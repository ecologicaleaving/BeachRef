  "resolutions": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-test-renderer": "19.1.1"
  },
  "overrides": {
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-test-renderer": "19.1.1"
  },
  "private": true
