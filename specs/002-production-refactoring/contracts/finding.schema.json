{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://beachref.app/schemas/audit/finding.schema.json",
  "title": "Finding",
  "description": "A single issue discovered during production readiness audit",
  "type": "object",
  "required": [
    "id",
    "type",
    "severity",
    "message",
    "file",
    "status",
    "requiresManualReview",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique deterministic identifier (16-char hex SHA-256 hash)",
      "pattern": "^[a-f0-9]{16}$"
    },
    "type": {
      "type": "string",
      "description": "Category of finding",
      "enum": [
        "typescript-error",
        "eslint-error",
        "eslint-warning",
        "complexity-cyclomatic",
        "complexity-cognitive",
        "security-credential",
        "security-cve",
        "security-http",
        "security-encryption",
        "security-sanitization",
        "architecture-di",
        "architecture-navigation",
        "architecture-component",
        "architecture-state",
        "error-handling-api",
        "error-handling-boundary",
        "error-handling-promise",
        "performance-cache",
        "performance-polling",
        "data-flow",
        "data-subscription",
        "data-sync",
        "build-failure",
        "build-config",
        "build-checklist"
      ]
    },
    "severity": {
      "type": "string",
      "description": "Impact level of the finding",
      "enum": ["Critical", "High", "Medium", "Low"]
    },
    "message": {
      "type": "string",
      "description": "Human-readable description of the issue",
      "minLength": 1
    },
    "file": {
      "type": "string",
      "description": "Relative file path from project root",
      "minLength": 1
    },
    "line": {
      "type": ["integer", "null"],
      "description": "Line number (optional for file-level findings)",
      "minimum": 1
    },
    "column": {
      "type": ["integer", "null"],
      "description": "Column number (optional)",
      "minimum": 1
    },
    "ruleId": {
      "type": ["string", "null"],
      "description": "ESLint rule ID or error code (e.g., 'typescript:2322')"
    },
    "status": {
      "type": "string",
      "description": "Lifecycle state across audit runs",
      "enum": ["New", "Existing", "Resolved"]
    },
    "requiresManualReview": {
      "type": "boolean",
      "description": "Whether finding needs human judgment"
    },
    "reviewGuidance": {
      "type": ["string", "null"],
      "description": "What to verify for manual review items"
    },
    "timestamp": {
      "type": "string",
      "description": "When finding was detected (ISO 8601 format)",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
